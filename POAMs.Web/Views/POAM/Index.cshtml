@model IEnumerable<POAMs.Web.Models.Domain.POAM>
@{
    ViewData["Title"] = "POAMs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3"><i class="bi bi-list-task me-2"></i>Plan of Action and Milestones</h1>
        <p class="text-muted mb-0">Manage and track security findings</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("ISSM") || User.IsInRole("ISSO") || User.IsInRole("SysAdmin"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>New POAM
        </a>
    }
</div>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Search</label>
                <input type="text" name="search" class="form-control" placeholder="ID, weakness, control..." value="@ViewBag.CurrentSearch" />
            </div>
            <div class="col-md-2">
                <label class="form-label">System</label>
                <select name="systemId" class="form-select" asp-items="@ViewBag.Systems">
                    <option value="">All Systems</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Status</label>
                <select name="status" class="form-select" asp-items="@ViewBag.Statuses">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Risk Level</label>
                <select name="risk" class="form-select" asp-items="@ViewBag.RiskLevels">
                    <option value="">All Levels</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-search me-1"></i>Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<!-- Quick Filters -->
<div class="mb-3">
    <div class="btn-group" role="group">
        <a asp-action="Index" class="btn btn-sm @(ViewBag.CurrentFilter == null ? "btn-primary" : "btn-outline-primary")">All</a>
        <a asp-action="Index" asp-route-filter="open" class="btn btn-sm @(ViewBag.CurrentFilter == "open" ? "btn-primary" : "btn-outline-primary")">Open/Ongoing</a>
        <a asp-action="Index" asp-route-filter="overdue" class="btn btn-sm @(ViewBag.CurrentFilter == "overdue" ? "btn-danger" : "btn-outline-danger")">Overdue</a>
        <a asp-action="Index" asp-route-filter="high" class="btn btn-sm @(ViewBag.CurrentFilter == "high" ? "btn-warning" : "btn-outline-warning")">High Risk</a>
    </div>
    <span class="ms-3 text-muted">@Model.Count() POAMs found</span>
</div>

<!-- POAMs Table -->
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Item ID</th>
                    <th>Weakness/Deficiency</th>
                    <th>Control</th>
                    <th>System</th>
                    <th>Status</th>
                    <th>Risk</th>
                    <th>Due Date</th>
                    <th>Milestones</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                            <p class="mt-3">No POAMs found matching your criteria.</p>
                        </td>
                    </tr>
                }
                @foreach (var poam in Model)
                {
                    var isOverdue = poam.ScheduledCompletionDate < DateTime.UtcNow &&
                                   poam.Status != POAMs.Web.Models.Domain.POAMStatus.Completed &&
                                   poam.Status != POAMs.Web.Models.Domain.POAMStatus.Closed;
                    <tr class="@(isOverdue ? "table-danger" : "")">
                        <td>
                            <a asp-action="Details" asp-route-id="@poam.Id" class="fw-bold text-decoration-none">
                                @poam.ItemIdentifier
                            </a>
                        </td>
                        <td class="text-truncate" style="max-width: 250px;" title="@poam.WeaknessOrDeficiency">
                            @poam.WeaknessOrDeficiency
                        </td>
                        <td>@poam.SecurityControl</td>
                        <td>@poam.System?.SystemName</td>
                        <td>
                            @{
                                var statusClass = poam.Status switch
                                {
                                    POAMs.Web.Models.Domain.POAMStatus.Draft => "bg-secondary",
                                    POAMs.Web.Models.Domain.POAMStatus.Open => "bg-info",
                                    POAMs.Web.Models.Domain.POAMStatus.Ongoing => "bg-primary",
                                    POAMs.Web.Models.Domain.POAMStatus.Completed => "bg-success",
                                    POAMs.Web.Models.Domain.POAMStatus.Closed => "bg-dark",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @statusClass">@poam.Status</span>
                        </td>
                        <td>
                            @{
                                var riskClass = poam.RiskLevel switch
                                {
                                    POAMs.Web.Models.Domain.RiskLevel.High => "bg-danger",
                                    POAMs.Web.Models.Domain.RiskLevel.Moderate => "bg-warning text-dark",
                                    POAMs.Web.Models.Domain.RiskLevel.Low => "bg-success",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @riskClass">@poam.RiskLevel</span>
                        </td>
                        <td>
                            <span class="@(isOverdue ? "text-danger fw-bold" : "")">
                                @poam.ScheduledCompletionDate.ToString("MM/dd/yyyy")
                                @if (isOverdue)
                                {
                                    <i class="bi bi-exclamation-circle ms-1"></i>
                                }
                            </span>
                        </td>
                        <td>
                            @{
                                var completedCount = poam.Milestones.Count(m => m.Status == POAMs.Web.Models.Domain.MilestoneStatus.Completed);
                                var totalCount = poam.Milestones.Count;
                            }
                            @if (totalCount > 0)
                            {
                                <span class="badge bg-light text-dark">@completedCount / @totalCount</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@poam.Id" class="btn btn-outline-primary" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (User.IsInRole("Admin") || User.IsInRole("ISSM") || User.IsInRole("ISSO") || User.IsInRole("SysAdmin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@poam.Id" class="btn btn-outline-secondary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                }
                                @if (User.IsInRole("Admin") || User.IsInRole("ISSM"))
                                {
                                    <a asp-action="Delete" asp-route-id="@poam.Id" class="btn btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
