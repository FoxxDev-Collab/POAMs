@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="mb-4">
            <i class="bi bi-shield-x text-danger" style="font-size: 5rem;"></i>
        </div>
        <h1 class="h2 text-danger">Access Denied</h1>
        <p class="lead text-muted">You do not have permission to access this resource.</p>
        <hr class="my-4" />
        <p>If you believe this is an error, please contact your administrator.</p>
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-house-door me-2"></i>Go to Dashboard
            </a>
            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary">
                <i class="bi bi-box-arrow-right me-2"></i>Logout
            </a>
        </div>
    </div>
</div>
