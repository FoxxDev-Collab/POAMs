@model POAMs.Web.Models.ViewModels.DocumentationSummaryPageViewModel
@using POAMs.Web.Models.ViewModels
@{
    ViewData["Title"] = "Documentation Summary";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">
            <i class="bi bi-bar-chart me-2"></i>Documentation Summary
        </h1>
        <p class="text-muted mb-0">
            Overview of documentation completion by control family
        </p>
    </div>
    <div>
        <a asp-action="Index" asp-route-systemId="@Model.SystemId" class="btn btn-outline-secondary">
            <i class="bi bi-table me-1"></i>Matrix View
        </a>
    </div>
</div>

<!-- System Selector -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get">
            <div class="row align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Select System</label>
                    <select name="systemId" class="form-select" onchange="this.form.submit()">
                        @foreach (var system in ViewBag.Systems as IEnumerable<SelectListItem>)
                        {
                            <option value="@system.Value" selected="@system.Selected">@system.Text</option>
                        }
                    </select>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!Model.SystemId.HasValue)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-hdd-stack text-muted" style="font-size: 3rem;"></i>
            <h4 class="mt-3">Select a System</h4>
            <p class="text-muted">Choose a system above to view its documentation summary.</p>
        </div>
    </div>
}
else
{
    <!-- Overall Stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-light">
                <div class="card-body text-center">
                    <div class="h1 mb-0">@Model.TotalRequirements</div>
                    <small class="text-muted">Total Requirements</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-secondary">
                <div class="card-body text-center">
                    <div class="h1 mb-0 text-secondary">@Model.TotalNotStarted</div>
                    <small class="text-muted">Not Started</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-primary">
                <div class="card-body text-center">
                    <div class="h1 mb-0 text-primary">@Model.TotalInProgress</div>
                    <small class="text-muted">In Progress</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success">
                <div class="card-body text-center">
                    <div class="h1 mb-0 text-success">@Model.TotalComplete</div>
                    <small class="text-muted">Complete</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Overall Progress Bar -->
    <div class="card mb-4">
        <div class="card-header">
            <i class="bi bi-graph-up me-2"></i>Overall Progress: @Model.OverallCompletionRate%
        </div>
        <div class="card-body">
            <div class="progress" style="height: 30px;">
                <div class="progress-bar bg-success" role="progressbar"
                     style="width: @Model.OverallCompletionRate%;"
                     aria-valuenow="@Model.OverallCompletionRate" aria-valuemin="0" aria-valuemax="100">
                    @if (Model.OverallCompletionRate >= 10)
                    {
                        <span>@Model.TotalComplete Complete</span>
                    }
                </div>
                @{
                    var inProgressPercent = Model.TotalRequirements > 0
                        ? Math.Round((decimal)Model.TotalInProgress / Model.TotalRequirements * 100, 1)
                        : 0;
                }
                <div class="progress-bar bg-primary" role="progressbar"
                     style="width: @inProgressPercent%;"
                     aria-valuenow="@inProgressPercent" aria-valuemin="0" aria-valuemax="100">
                    @if (inProgressPercent >= 10)
                    {
                        <span>@Model.TotalInProgress In Progress</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Family Breakdown -->
    <div class="card">
        <div class="card-header">
            <i class="bi bi-grid me-2"></i>Progress by Control Family
        </div>
        <div class="card-body p-0">
            @if (Model.FamilySummaries.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Family</th>
                                <th class="text-center" style="width: 100px;">Total</th>
                                <th class="text-center" style="width: 100px;">Not Started</th>
                                <th class="text-center" style="width: 100px;">In Progress</th>
                                <th class="text-center" style="width: 100px;">Complete</th>
                                <th style="width: 200px;">Progress</th>
                                <th style="width: 60px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var family in Model.FamilySummaries)
                            {
                                var familyName = NISTFamilyNames.GetName(family.Family);
                                <tr>
                                    <td>
                                        <span class="badge bg-dark me-2">@family.Family</span>
                                        @familyName
                                    </td>
                                    <td class="text-center">@family.TotalRequirements</td>
                                    <td class="text-center">
                                        @if (family.NotStarted > 0)
                                        {
                                            <span class="badge bg-secondary">@family.NotStarted</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (family.InProgress > 0)
                                        {
                                            <span class="badge bg-primary">@family.InProgress</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (family.Complete > 0)
                                        {
                                            <span class="badge bg-success">@family.Complete</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="progress" style="height: 20px;">
                                            <div class="progress-bar bg-success" role="progressbar"
                                                 style="width: @family.CompletionRate%;"
                                                 title="@family.Complete complete">
                                            </div>
                                            @{
                                                var famInProgressPercent = family.TotalRequirements > 0
                                                    ? Math.Round((decimal)family.InProgress / family.TotalRequirements * 100, 1)
                                                    : 0;
                                            }
                                            <div class="progress-bar bg-primary" role="progressbar"
                                                 style="width: @famInProgressPercent%;"
                                                 title="@family.InProgress in progress">
                                            </div>
                                        </div>
                                        <small class="text-muted">@family.CompletionRate%</small>
                                    </td>
                                    <td>
                                        <a asp-action="Index" asp-route-systemId="@Model.SystemId" asp-route-family="@family.Family"
                                           class="btn btn-sm btn-outline-secondary" title="View Details">
                                            <i class="bi bi-arrow-right"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-file-earmark-x text-muted" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">No Documentation Data</h5>
                    <p class="text-muted">No documentation requirements have been configured yet.</p>
                </div>
            }
        </div>
    </div>
}
