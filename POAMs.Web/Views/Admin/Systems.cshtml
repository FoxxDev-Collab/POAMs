@model IEnumerable<POAMs.Web.Models.Domain.SystemInfo>
@{
    ViewData["Title"] = "System Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3"><i class="bi bi-hdd-network me-2"></i>System Management</h1>
        <p class="text-muted mb-0">Manage information systems for POAMs</p>
    </div>
    <a asp-action="CreateSystem" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>Add System
    </a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>System Name</th>
                    <th>Organization</th>
                    <th>IS Type</th>
                    <th>UID</th>
                    <th>ISSM</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                            <p class="mt-3">No systems found. <a asp-action="CreateSystem">Add your first system</a></p>
                        </td>
                    </tr>
                }
                @foreach (var system in Model)
                {
                    <tr>
                        <td class="fw-bold">@system.SystemName</td>
                        <td>@system.OrganizationName</td>
                        <td>@(system.ISType ?? "-")</td>
                        <td>@(system.UID ?? "-")</td>
                        <td>@(system.ISSM?.DisplayName ?? "-")</td>
                        <td class="text-end">
                            <a asp-action="EditSystem" asp-route-id="@system.Id" class="btn btn-sm btn-outline-secondary" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
