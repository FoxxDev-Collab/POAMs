@model POAMs.Web.Models.ViewModels.ImportResultViewModel
@{
    ViewData["Title"] = "Import Results";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Data Import</a></li>
        <li class="breadcrumb-item active">Results</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <!-- Result Summary -->
        <div class="card mb-4">
            <div class="card-header @(Model.Success ? "bg-success text-white" : "bg-danger text-white")">
                <i class="bi @(Model.Success ? "bi-check-circle" : "bi-x-circle") me-2"></i>
                @(Model.Success ? "Import Successful" : "Import Failed")
            </div>
            <div class="card-body">
                <p class="lead mb-4">@Model.Message</p>

                <div class="row g-3 text-center">
                    <div class="col-md-3">
                        <div class="border rounded p-3">
                            <div class="h3 mb-0">@Model.RecordsProcessed</div>
                            <small class="text-muted">Processed</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded p-3 border-success">
                            <div class="h3 mb-0 text-success">@Model.RecordsAdded</div>
                            <small class="text-muted">Added</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded p-3 border-warning">
                            <div class="h3 mb-0 text-warning">@Model.RecordsSkipped</div>
                            <small class="text-muted">Skipped</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded p-3 border-info">
                            <div class="h3 mb-0 text-info">@Model.RecordsUpdated</div>
                            <small class="text-muted">Updated</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Errors.Any())
        {
            <!-- Errors -->
            <div class="card border-danger mb-4">
                <div class="card-header bg-danger text-white">
                    <i class="bi bi-exclamation-triangle me-2"></i>Errors (@Model.Errors.Count)
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush" style="max-height: 300px; overflow-y: auto;">
                        @foreach (var error in Model.Errors)
                        {
                            <div class="list-group-item list-group-item-danger small">
                                <i class="bi bi-x-circle me-2"></i>@error
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (Model.Warnings.Any())
        {
            <!-- Warnings -->
            <div class="card border-warning mb-4">
                <div class="card-header bg-warning">
                    <i class="bi bi-exclamation-circle me-2"></i>Warnings (@Model.Warnings.Count)
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush" style="max-height: 300px; overflow-y: auto;">
                        @foreach (var warning in Model.Warnings)
                        {
                            <div class="list-group-item list-group-item-warning small">
                                <i class="bi bi-exclamation-triangle me-2"></i>@warning
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Actions -->
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-primary">
                <i class="bi bi-arrow-left me-1"></i>Back to Import Dashboard
            </a>
            @if (Model.Success)
            {
                <a asp-controller="NISTCatalog" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-shield-check me-1"></i>View NIST Catalog
                </a>
                <a asp-controller="Documentation" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-file-earmark-text me-1"></i>View Documentation
                </a>
            }
        </div>
    </div>
</div>
