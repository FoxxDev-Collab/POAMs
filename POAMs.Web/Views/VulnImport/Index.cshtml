@model List<POAMs.Web.Models.ViewModels.VulnImportSessionListItem>
@{
    ViewData["Title"] = "Vulnerability Import Sessions";
}

@section Styles {
    <link rel="stylesheet" href="~/css/metrics.css" asp-append-version="true" />
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-upload me-2"></i>Vulnerability Import</h1>
        <p class="text-muted mb-0">Import and analyze data from Vulnerability Management exports</p>
    </div>
    <div>
        <a asp-action="Import" class="btn btn-primary">
            <i class="bi bi-cloud-upload me-1"></i>Import New
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Any())
{
    <div class="card">
        <div class="card-header">
            <i class="bi bi-clock-history me-2"></i>Import History
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover site-breakdown-table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Import Date</th>
                            <th>File</th>
                            <th>Imported By</th>
                            <th class="text-center">Hosts</th>
                            <th class="text-center severity-cell">Critical</th>
                            <th class="text-center severity-cell">High</th>
                            <th class="text-center">STIG Open</th>
                            <th class="text-center" style="min-width: 120px;">Compliance</th>
                            <th class="text-center">Risk</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in Model)
                        {
                            var riskClass = session.RiskLevel switch
                            {
                                "Critical" => "risk-critical",
                                "High" => "risk-high",
                                "Medium" => "risk-medium",
                                "Low" => "risk-low",
                                _ => "risk-minimal"
                            };
                            var complianceClass = session.StigCompliancePercentage >= 90 ? "bg-success" :
                                                 session.StigCompliancePercentage >= 70 ? "bg-primary" :
                                                 session.StigCompliancePercentage >= 50 ? "bg-warning" : "bg-danger";
                            <tr>
                                <td>
                                    <strong>@session.ImportDate.ToString("MMM dd, yyyy")</strong>
                                    <br /><small class="text-muted">@session.ImportDate.ToString("h:mm tt")</small>
                                </td>
                                <td>
                                    <span class="text-truncate d-inline-block" style="max-width: 200px;" title="@session.FileName">
                                        @session.FileName
                                    </span>
                                    <br /><small class="text-muted">@session.SourceApplication</small>
                                </td>
                                <td>@session.ImportedBy</td>
                                <td class="text-center">@session.TotalHosts</td>
                                <td class="text-center severity-cell">
                                    @if (session.NessusCritical > 0)
                                    {
                                        <span class="badge bg-danger">@session.NessusCritical</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>
                                <td class="text-center severity-cell">
                                    @if (session.NessusHigh > 0)
                                    {
                                        <span class="badge bg-warning text-dark">@session.NessusHigh</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (session.StigOpen > 0)
                                    {
                                        <span class="badge bg-danger">@session.StigOpen</span>
                                    }
                                    else
                                    {
                                        <span class="text-success">0</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (session.TotalStigFindings > 0)
                                    {
                                        <div class="benchmark-bar">
                                            <div class="benchmark-bar-fill @complianceClass" style="width: @session.StigCompliancePercentage%">
                                                @session.StigCompliancePercentage.ToString("F1")%
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge risk-badge @riskClass">@session.RiskLevel</span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Dashboard" asp-route-id="@session.Id"
                                       class="btn btn-sm btn-outline-primary" title="View Dashboard">
                                        <i class="bi bi-graph-up"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@session.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this import session?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-cloud-upload text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3">No Import Sessions</h4>
            <p class="text-muted">Import your first Vulnerability Management export to get started.</p>
            <a asp-action="Import" class="btn btn-primary">
                <i class="bi bi-cloud-upload me-1"></i>Import Now
            </a>
        </div>
    </div>
}
