@model POAMs.Web.Models.Domain.NessusTestCase
@{
    ViewData["Title"] = $"Edit Finding: {Model.PluginId}";
    var stp = ViewBag.STP as POAMs.Web.Models.Domain.SecurityTestPlan;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Test Plans</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@stp?.Id">@stp?.STPIdentifier</a></li>
        <li class="breadcrumb-item active">Edit @Model.PluginId</li>
    </ol>
</nav>

<h1 class="h3 mb-4">
    <i class="bi bi-pencil me-2"></i>Edit Vulnerability Finding: @Model.PluginId
</h1>

<form asp-action="EditNessusTestCase" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="SecurityTestPlanId" />
    <input type="hidden" asp-for="CreatedDate" />

    <div class="row">
        <div class="col-lg-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-info-circle me-2"></i>Plugin Information
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PluginId" class="form-label">Plugin ID</label>
                            <input asp-for="PluginId" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PluginFamily" class="form-label">Plugin Family</label>
                            <input asp-for="PluginFamily" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PluginName" class="form-label">Plugin Name</label>
                        <input asp-for="PluginName" class="form-control" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CVE" class="form-label">CVE</label>
                            <input asp-for="CVE" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Severity" class="form-label">Severity</label>
                            <select asp-for="Severity" class="form-select">
                                <option value="Critical">Critical</option>
                                <option value="High">High</option>
                                <option value="Medium">Medium</option>
                                <option value="Low">Low</option>
                                <option value="Info">Informational</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CVSSScore" class="form-label">CVSS Score</label>
                            <input asp-for="CVSSScore" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="CVSSVector" class="form-label">CVSS Vector</label>
                            <input asp-for="CVSSVector" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-pc-display me-2"></i>Affected Assets
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="AffectedHosts" class="form-label">Affected Hosts</label>
                        <textarea asp-for="AffectedHosts" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="AffectedPorts" class="form-label">Affected Ports</label>
                        <input asp-for="AffectedPorts" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-file-text me-2"></i>Finding Details
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Synopsis" class="form-label">Synopsis</label>
                        <textarea asp-for="Synopsis" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Solution" class="form-label">Solution</label>
                        <textarea asp-for="Solution" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PluginOutput" class="form-label">Plugin Output</label>
                        <textarea asp-for="PluginOutput" class="form-control font-monospace" rows="3"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-clipboard-check me-2"></i>Test Results
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Status" class="form-label">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="NotTested">Not Tested</option>
                            <option value="InProgress">In Progress</option>
                            <option value="Remediated">Remediated</option>
                            <option value="PartiallyRemediated">Partially Remediated</option>
                            <option value="NotRemediated">Not Remediated</option>
                            <option value="FalsePositive">False Positive</option>
                            <option value="AcceptedRisk">Accepted Risk</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ExpectedResult" class="form-label">Expected Result</label>
                        <textarea asp-for="ExpectedResult" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ActualResult" class="form-label">Actual Result</label>
                        <textarea asp-for="ActualResult" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RemediationSteps" class="form-label">Remediation Steps</label>
                        <textarea asp-for="RemediationSteps" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Evidence" class="form-label">Evidence</label>
                        <textarea asp-for="Evidence" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-arrow-repeat me-2"></i>Rescan Information
                </div>
                <div class="card-body">
                    <div class="form-check mb-3">
                        <input asp-for="RescanRequired" class="form-check-input" type="checkbox" />
                        <label asp-for="RescanRequired" class="form-check-label">Rescan Required</label>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="OriginalScanDate" class="form-label">Original Scan Date</label>
                            <input asp-for="OriginalScanDate" type="date" class="form-control"
                                   value="@(Model.OriginalScanDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="RescanDate" class="form-label">Rescan Date</label>
                            <input asp-for="RescanDate" type="date" class="form-control"
                                   value="@(Model.RescanDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RescanResults" class="form-label">Rescan Results</label>
                        <textarea asp-for="RescanResults" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-person me-2"></i>Tester Information
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="TesterId" class="form-label">Tested By</label>
                            <select asp-for="TesterId" asp-items="@ViewBag.Users" class="form-select">
                                <option value="">-- Select --</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="TestDate" class="form-label">Test Date</label>
                            <input asp-for="TestDate" type="date" class="form-control"
                                   value="@(Model.TestDate?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between">
        <a asp-action="Details" asp-route-id="@Model.SecurityTestPlanId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Cancel
        </a>
        <div>
            <button type="button" class="btn btn-outline-danger me-2" data-bs-toggle="modal" data-bs-target="#deleteModal">
                <i class="bi bi-trash me-1"></i>Delete
            </button>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle me-1"></i>Save Changes
            </button>
        </div>
    </div>
</form>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete vulnerability finding <strong>@Model.PluginId</strong>?</p>
                <p class="text-danger">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="DeleteNessusTestCase" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
