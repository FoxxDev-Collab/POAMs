@model POAMs.Web.Models.ViewModels.MilestoneEditViewModel
@{
    ViewData["Title"] = "Edit Milestone";
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-controller="POAM" asp-action="Index">POAMs</a></li>
            <li class="breadcrumb-item"><a asp-controller="POAM" asp-action="Details" asp-route-id="@Model.POAMId">@Model.POAMIdentifier</a></li>
            <li class="breadcrumb-item active">Edit Milestone @Model.MilestoneNumber</li>
        </ol>
    </nav>
    <h1 class="h3"><i class="bi bi-pencil me-2"></i>Edit Milestone</h1>
</div>

<div class="row">
    <div class="col-lg-6">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="POAMId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-info-circle me-2"></i>Milestone Details
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="MilestoneNumber" class="form-label"></label>
                            <input asp-for="MilestoneNumber" type="number" class="form-control" />
                            <span asp-validation-for="MilestoneNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="DueDate" class="form-label"></label>
                            <input asp-for="DueDate" type="date" class="form-control" />
                            <span asp-validation-for="DueDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<POAMs.Web.Models.Domain.MilestoneStatus>()"></select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AssignedToId" class="form-label"></label>
                        <select asp-for="AssignedToId" class="form-select" asp-items="@ViewBag.Users">
                            <option value="">-- Select User --</option>
                        </select>
                        <span asp-validation-for="AssignedToId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Changes" class="form-label"></label>
                        <textarea asp-for="Changes" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Changes" class="text-danger"></span>
                        <div class="form-text">Document any changes made to this milestone</div>
                    </div>

                    @if (Model.CompletedDate.HasValue)
                    {
                        <div class="alert alert-success mb-0">
                            <i class="bi bi-check-circle me-2"></i>
                            Completed on @Model.CompletedDate.Value.ToString("MM/dd/yyyy")
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-2"></i>Save Changes
                </button>
                <a asp-controller="POAM" asp-action="Details" asp-route-id="@Model.POAMId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-lightning me-2"></i>Quick Status Update
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="status" value="@POAMs.Web.Models.Domain.MilestoneStatus.InProgress" />
                        <button type="submit" class="btn btn-outline-primary w-100" @(Model.Status == POAMs.Web.Models.Domain.MilestoneStatus.InProgress ? "disabled" : "")>
                            <i class="bi bi-play-circle me-2"></i>Mark In Progress
                        </button>
                    </form>
                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="status" value="@POAMs.Web.Models.Domain.MilestoneStatus.Completed" />
                        <button type="submit" class="btn btn-outline-success w-100" @(Model.Status == POAMs.Web.Models.Domain.MilestoneStatus.Completed ? "disabled" : "")>
                            <i class="bi bi-check-circle me-2"></i>Mark Completed
                        </button>
                    </form>
                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="status" value="@POAMs.Web.Models.Domain.MilestoneStatus.Blocked" />
                        <button type="submit" class="btn btn-outline-danger w-100" @(Model.Status == POAMs.Web.Models.Domain.MilestoneStatus.Blocked ? "disabled" : "")>
                            <i class="bi bi-x-circle me-2"></i>Mark Blocked
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
