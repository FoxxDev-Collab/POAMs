@model POAMs.Web.Models.ViewModels.MilestoneEditViewModel
@{
    ViewData["Title"] = "Add Milestone";
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a asp-controller="POAM" asp-action="Index">POAMs</a></li>
            <li class="breadcrumb-item"><a asp-controller="POAM" asp-action="Details" asp-route-id="@Model.POAMId">@Model.POAMIdentifier</a></li>
            <li class="breadcrumb-item active">Add Milestone</li>
        </ol>
    </nav>
    <h1 class="h3"><i class="bi bi-flag me-2"></i>Add Milestone</h1>
</div>

<div class="row">
    <div class="col-lg-6">
        <form asp-action="Create" method="post">
            <input type="hidden" asp-for="POAMId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-info-circle me-2"></i>Milestone Details
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="MilestoneNumber" class="form-label"></label>
                            <input asp-for="MilestoneNumber" type="number" class="form-control" />
                            <span asp-validation-for="MilestoneNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" placeholder="e.g., Create Security Test Plan" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="DueDate" class="form-label"></label>
                            <input asp-for="DueDate" type="date" class="form-control" />
                            <span asp-validation-for="DueDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<POAMs.Web.Models.Domain.MilestoneStatus>()"></select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AssignedToId" class="form-label"></label>
                        <select asp-for="AssignedToId" class="form-select" asp-items="@ViewBag.Users">
                            <option value="">-- Select User --</option>
                        </select>
                        <span asp-validation-for="AssignedToId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Changes" class="form-label"></label>
                        <textarea asp-for="Changes" class="form-control" rows="2" placeholder="Track any changes to this milestone..."></textarea>
                        <span asp-validation-for="Changes" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-2"></i>Add Milestone
                </button>
                <a asp-controller="POAM" asp-action="Details" asp-route-id="@Model.POAMId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
